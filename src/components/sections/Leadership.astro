---
import { User, Award, ShieldCheck, ArrowRight } from "lucide-react";

interface LeadershipData {
  eyebrow?: string;
  title?: string;
  body?: string;
  kicker?: string;
  name?: string;
  role?: string;
  stat1Title?: string;
  stat1Body?: string;
  stat2Title?: string;
  stat2Body?: string;
  cta?: string;
  photoUrl?: string;
}

interface Props {
  data?: LeadershipData;
  fields?: {
    eyebrow?: Record<string, unknown>;
    title?: Record<string, unknown>;
    body?: Record<string, unknown>;
    kicker?: Record<string, unknown>;
    name?: Record<string, unknown>;
    role?: Record<string, unknown>;
    stat1Title?: Record<string, unknown>;
    stat1Body?: Record<string, unknown>;
    stat2Title?: Record<string, unknown>;
    stat2Body?: Record<string, unknown>;
    cta?: Record<string, unknown>;
  };
}

const { data, fields } = Astro.props;

const eyebrow = data?.eyebrow ?? "Leadership";
const title = data?.title ?? "Experience across banking risk, financial crime and technology.";
const body = data?.body ?? "ALTIX was founded by Elke Biechele, whose management biography describes more than 25 years across financial services, risk, financial crime, technology and entrepreneurship, followed by a focus on international financial-crime investigations and asset recovery.";
const kicker = data?.kicker ?? "EXECUTIVE BIOGRAPHY";
const name = data?.name ?? "Elke Biechele";
const role = data?.role ?? "Founder & CEO, ALTIX Exchange";
const stat1Title = data?.stat1Title ?? "25+ Years Experience";
const stat1Body = data?.stat1Body ?? "Across financial services, risk, technology & asset recovery.";
const stat2Title = data?.stat2Title ?? "Financial Crime Focus";
const stat2Body = data?.stat2Body ?? "Specializing in cross-border investigations & litigation capital.";
const cta = data?.cta ?? "View Leadership Profile";
const photoUrl = data?.photoUrl ?? "/assets/img/elke-biechele.webp";
---

<section class="section bg-white border-t border-slate-200">
  <div class="container">
    {/* Eyebrow */}
    <div class="eyebrow mb-2">
      <User className="w-4 h-4 text-[#e6463a]" />
      <span {...fields?.eyebrow}>{eyebrow}</span>
    </div>

    {/* Section Head */}
    <div class="section-head">
      <h2 {...fields?.title}>{title}</h2>
      <p {...fields?.body}>{body}</p>
    </div>

    {/* Leadership Feature Card */}
    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 sm:p-10 grid grid-cols-1 md:grid-cols-12 gap-8 items-center shadow-lg hover:shadow-2xl transition-all duration-300">
      <div class="md:col-span-4 max-w-[280px] mx-auto md:mx-0">
        <div class="relative rounded-xl overflow-hidden shadow-xl border-2 border-white">
          <img
            src={photoUrl}
            alt={`${name}, founder and CEO of ALTIX Exchange`}
            class="w-full h-auto object-cover grayscale hover:grayscale-0 transition-all duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent opacity-80 pointer-events-none" />
          <div class="absolute bottom-3 left-3 right-3 text-white pointer-events-none">
            <span class="text-xs font-mono font-bold uppercase text-red-400">
              Founder & CEO
            </span>
          </div>
        </div>
      </div>

      <div class="md:col-span-8 space-y-5">
        <div>
          <span class="text-xs font-mono font-bold tracking-widest text-[#e6463a] uppercase" {...fields?.kicker}>
            {kicker}
          </span>
          <h3 class="text-3xl font-bold text-slate-900 mt-1" {...fields?.name}>{name}</h3>
          <p class="text-slate-600 font-medium text-sm" {...fields?.role}>{role}</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="p-3.5 rounded-xl bg-white border border-slate-200 flex items-start gap-3">
            <Award className="w-5 h-5 text-[#e6463a] flex-shrink-0 mt-0.5" />
            <div>
              <h4 class="text-xs font-bold text-slate-900 uppercase" {...fields?.stat1Title}>{stat1Title}</h4>
              <p class="text-xs text-slate-500" {...fields?.stat1Body}>{stat1Body}</p>
            </div>
          </div>

          <div class="p-3.5 rounded-xl bg-white border border-slate-200 flex items-start gap-3">
            <ShieldCheck className="w-5 h-5 text-sky-500 flex-shrink-0 mt-0.5" />
            <div>
              <h4 class="text-xs font-bold text-slate-900 uppercase" {...fields?.stat2Title}>{stat2Title}</h4>
              <p class="text-xs text-slate-500" {...fields?.stat2Body}>{stat2Body}</p>
            </div>
          </div>
        </div>

        <div class="pt-2">
          <a class="button button--secondary" href="/about/leadership/elke-biechele">
            <span {...fields?.cta}>{cta}</span>
            <ArrowRight className="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
