---
import { Layers, Sparkles, Clock, Compass } from "lucide-react";

interface RoadmapItem {
  status?: string;
  title?: string;
  description?: string;
}

interface RoadmapData {
  eyebrow?: string;
  title?: string;
  body?: string;
  items?: RoadmapItem[];
}

interface Props {
  data?: RoadmapData;
}

const { data } = Astro.props;

const eyebrow = data?.eyebrow ?? "Product clarity";
const title = data?.title ?? "Current platform and development roadmap.";
const body = data?.body ?? "ALTIX distinguishes what management reports as available today from future functions requiring further product, legal and regulatory work.";

const defaultItems = [
  {
    badgeStyle: 'bg-red-500/10 text-red-600 border-red-500/30',
    dotColor: 'bg-red-500',
    icon: Sparkles,
    fallback: {
      status: 'NOW',
      title: 'Current platform functions',
      description: 'Management reports guided claimant intake, case browsing, filters, structured opportunity profiles and separate claimant and investor journeys.',
    },
  },
  {
    badgeStyle: 'bg-sky-500/10 text-sky-600 border-sky-500/30',
    dotColor: 'bg-sky-500',
    icon: Clock,
    fallback: {
      status: 'NEXT',
      title: 'Institutional development',
      description: 'Secure evidence rooms, role-based access, audit trails, case workflow, KYC/AML integration, investor diligence, milestone tracking, digital closing and reporting.',
    },
  },
  {
    badgeStyle: 'bg-amber-500/10 text-amber-600 border-amber-500/30',
    dotColor: 'bg-amber-500',
    icon: Compass,
    fallback: {
      status: 'FUTURE / SUBJECT TO APPROVAL',
      title: 'Digital ownership and transfers',
      description: 'Any future digital ownership records or transfer functionality will require valid legal rights, compliant structures and appropriate regulatory permissions.',
    },
  },
];

const items = defaultItems.map((item, index) => {
  const itemData = data?.items?.[index];
  return {
    ...item,
    status: itemData?.status ?? item.fallback.status,
    title: itemData?.title ?? item.fallback.title,
    description: itemData?.description ?? item.fallback.description,
  };
});
---

<section class="section bg-[#f8fafc]">
  <div class="container">
    {/* Eyebrow */}
    <div class="eyebrow mb-2">
      <Layers className="w-4 h-4 text-[#e6463a]" />
      <span>{eyebrow}</span>
    </div>

    {/* Section Head */}
    <div class="section-head">
      <h2>{title}</h2>
      <p>{body}</p>
    </div>

    {/* Roadmap Grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {items.map((item) => {
        const Icon = item.icon;
        return (
          <article class="bg-white border border-slate-200 border-t-4 border-t-[#e6463a] p-6 sm:p-8 rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold tracking-wider border ${item.badgeStyle}`}>
                  <span class={`w-2 h-2 rounded-full ${item.dotColor} animate-pulse`} />
                  <span>{item.status}</span>
                </span>
                <Icon className="w-5 h-5 text-slate-400" />
              </div>

              <h3 class="text-xl font-bold text-slate-900 mb-3">{item.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{item.description}</p>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
