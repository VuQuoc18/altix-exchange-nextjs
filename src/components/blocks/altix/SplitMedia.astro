---
interface Props {
	node: {
		eyebrow?: string;
		title: string;
		body?: string;
		imageUrl: string;
		imageAlt?: string;
		imagePosition?: "left" | "right";
		bullets?: string;
		primaryCtaLabel?: string;
		primaryCtaUrl?: string;
		secondaryCtaLabel?: string;
		secondaryCtaUrl?: string;
	};
}

const { node } = Astro.props;
const {
	eyebrow,
	title,
	body,
	imageUrl,
	imageAlt,
	imagePosition = "right",
	bullets,
	primaryCtaLabel,
	primaryCtaUrl,
	secondaryCtaLabel,
	secondaryCtaUrl,
} = node;

const bulletList = bullets
	? bullets
			.split("\n")
			.map((b) => b.trim())
			.filter((b) => b.length > 0)
	: [];
---

<section class="section py-16 md:py-24">
	<div class="container mx-auto px-4 max-w-7xl">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
			<!-- Text Column -->
			<div class={`lg:col-span-6 ${imagePosition === "left" ? "lg:order-2" : "lg:order-1"}`}>
				{eyebrow && (
					<span class="eyebrow inline-block text-xs font-semibold tracking-wider uppercase text-altix-red dark:text-altix-red-light mb-3">
						{eyebrow}
					</span>
				)}
				<h2 class="text-3xl md:text-4xl font-bold tracking-tight text-navy dark:text-white mb-6 leading-tight">
					{title}
				</h2>
				{body && (
					<p class="text-base md:text-lg text-gray-600 dark:text-gray-300 leading-relaxed mb-8">
						{body}
					</p>
				)}

				{bulletList.length > 0 && (
					<ul class="space-y-3.5 mb-8">
						{bulletList.map((item) => (
							<li class="flex items-start gap-3 text-gray-700 dark:text-gray-200">
								<div class="flex-none p-1 rounded-full bg-altix-red/10 dark:bg-navy-dark/60 text-altix-red dark:text-altix-red-light mt-0.5 border border-altix-red/20 dark:border-navy2/50">
									<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
										<path d="M20 6 9 17l-5-5"/>
									</svg>
								</div>
								<span class="text-sm md:text-base leading-snug">{item}</span>
							</li>
						))}
					</ul>
				)}

				{(primaryCtaLabel || secondaryCtaLabel) && (
					<div class="flex flex-wrap gap-4 items-center">
						{primaryCtaLabel && primaryCtaUrl && (
							<a 
								href={primaryCtaUrl} 
								class="inline-flex items-center justify-center py-3 px-6 rounded-xl bg-altix-red hover:bg-altix-red-hover text-white font-semibold text-sm transition-all duration-200 shadow-sm hover:shadow"
							>
								<span>{primaryCtaLabel}</span>
								<svg class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="m9 18 6-6-6-6"/>
								</svg>
							</a>
						)}
						{secondaryCtaLabel && secondaryCtaUrl && (
							<a 
								href={secondaryCtaUrl} 
								class="inline-flex items-center justify-center py-3 px-6 rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-750 text-gray-700 dark:text-gray-200 font-semibold text-sm transition-all duration-200 shadow-sm"
							>
								{secondaryCtaLabel}
							</a>
						)}
					</div>
				)}
			</div>

			<!-- Media Column -->
			<div class={`lg:col-span-6 ${imagePosition === "left" ? "lg:order-1" : "lg:order-2"}`}>
				{imageUrl ? (
					<div class="relative rounded-3xl overflow-hidden shadow-2xl border border-gray-200/80 dark:border-gray-700/80 bg-gray-100 dark:bg-gray-800">
						<img 
							src={imageUrl} 
							alt={imageAlt || title} 
							class="w-full h-full object-cover transition-transform duration-700 hover:scale-102"
							loading="lazy"
						/>
					</div>
				) : (
					<div class="aspect-[4/3] rounded-3xl border-2 border-dashed border-gray-300 dark:border-gray-700 flex items-center justify-center text-gray-400">
						<span>No image provided</span>
					</div>
				)}
			</div>
		</div>
	</div>
</section>
