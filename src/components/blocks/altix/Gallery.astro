---
interface GalleryImage {
	url: string;
	alt?: string;
	caption?: string;
	tag?: string;
}

interface Props {
	node: {
		eyebrow?: string;
		headline?: string;
		subheadline?: string;
		columns?: string; // "2" | "3" | "4"
		aspectRatio?: string; // "auto" | "square" | "16:9" | "4:3"
		images?: GalleryImage[];
	};
}

const { node } = Astro.props;
const { eyebrow, headline, subheadline, columns = "3", aspectRatio = "4:3", images = [] } = node;

const colClass = 
	columns === "2" ? "grid-cols-1 sm:grid-cols-2" :
	columns === "4" ? "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" :
	"grid-cols-1 sm:grid-cols-2 lg:grid-cols-3";

const aspectClass =
	aspectRatio === "square" ? "aspect-square" :
	aspectRatio === "16:9" ? "aspect-video" :
	aspectRatio === "auto" ? "aspect-auto" :
	"aspect-[4/3]";

const galleryId = "gallery-" + Math.random().toString(36).substring(2, 9);
---

<section class="section py-16 md:py-24" id={galleryId}>
	<div class="container mx-auto px-4 max-w-7xl">
		{(eyebrow || headline || subheadline) && (
			<div class="section-head text-center max-w-3xl mx-auto mb-12">
				{eyebrow && <span class="eyebrow inline-block text-xs font-semibold tracking-wider uppercase text-altix-red dark:text-altix-red-light mb-2">{eyebrow}</span>}
				{headline && <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-navy dark:text-white mb-4">{headline}</h2>}
				{subheadline && <p class="text-base md:text-lg text-gray-600 dark:text-gray-300 leading-relaxed">{subheadline}</p>}
			</div>
		)}

		{images && images.length > 0 ? (
			<div class={`grid gap-6 ${colClass}`}>
				{images.map((img, idx) => (
					<div 
						class="gallery-item group relative rounded-2xl overflow-hidden bg-gray-100 dark:bg-gray-800 border border-gray-200/80 dark:border-gray-700/80 shadow-sm cursor-zoom-in transition-all duration-300 hover:shadow-lg hover:-translate-y-1"
						data-src={img.url}
						data-caption={img.caption || ""}
						data-alt={img.alt || `Gallery image ${idx + 1}`}
					>
						<div class={`w-full overflow-hidden ${aspectClass}`}>
							<img 
								src={img.url} 
								alt={img.alt || img.caption || `Image ${idx + 1}`} 
								class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
								loading="lazy"
							/>
						</div>

						{img.tag && (
							<span class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-xs font-semibold bg-white/90 dark:bg-gray-900/90 text-gray-800 dark:text-gray-200 backdrop-blur-sm shadow-sm">
								{img.tag}
							</span>
						)}

						{img.caption && (
							<div class="p-4 bg-white dark:bg-gray-800/95 border-t border-gray-100 dark:border-gray-700/50">
								<p class="text-sm font-medium text-gray-800 dark:text-gray-200">{img.caption}</p>
							</div>
						)}
					</div>
				))}
			</div>
		) : (
			<div class="text-center py-12 border-2 border-dashed border-gray-300 dark:border-gray-700 rounded-2xl">
				<p class="text-gray-500 dark:text-gray-400">No images in this gallery yet.</p>
			</div>
		)}
	</div>

	<!-- Built-in Lightbox Modal -->
	<dialog class="lightbox-modal p-0 rounded-2xl bg-transparent backdrop:bg-black/80 max-w-5xl w-[92vw] max-h-[90vh] overflow-hidden shadow-2xl border-0 focus:outline-none">
		<div class="relative flex flex-col items-center justify-center p-2 sm:p-4">
			<button 
				type="button" 
				class="lightbox-close absolute top-4 right-4 z-10 p-2 rounded-full bg-black/60 hover:bg-black/80 text-white transition-colors cursor-pointer"
				aria-label="Close image preview"
			>
				<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M18 6 6 18M6 6l12 12"/>
				</svg>
			</button>
			<img class="lightbox-img max-h-[80vh] w-auto max-w-full rounded-xl object-contain shadow-2xl" src="" alt="" />
			<p class="lightbox-caption text-sm sm:text-base text-white font-medium text-center mt-3 px-4 drop-shadow-md"></p>
		</div>
	</dialog>
</section>

<script define:vars={{ galleryId }}>
	const gallery = document.getElementById(galleryId);
	if (gallery) {
		const modal = gallery.querySelector(".lightbox-modal");
		const modalImg = gallery.querySelector(".lightbox-img");
		const modalCaption = gallery.querySelector(".lightbox-caption");
		const closeBtn = gallery.querySelector(".lightbox-close");
		const items = gallery.querySelectorAll(".gallery-item");

		items.forEach((item) => {
			item.addEventListener("click", () => {
				const src = item.dataset.src;
				const alt = item.dataset.alt;
				const caption = item.dataset.caption;

				if (modal && modalImg && src) {
					modalImg.src = src;
					modalImg.alt = alt || "";
					if (modalCaption) modalCaption.textContent = caption || "";
					modal.showModal();
				}
			});
		});

		if (modal) {
			modal.addEventListener("click", (e) => {
				if (e.target === modal) modal.close();
			});
			if (closeBtn) closeBtn.addEventListener("click", () => modal.close());
		}
	}
</script>
