---
interface CardItem {
	imageUrl?: string;
	badge?: string;
	title: string;
	description?: string;
	linkText?: string;
	linkUrl?: string;
}

interface Props {
	node: {
		eyebrow?: string;
		title?: string;
		subtitle?: string;
		columns?: string; // "2" | "3" | "4"
		cards?: CardItem[];
	};
}

const { node } = Astro.props;
const { eyebrow, title, subtitle, columns = "3", cards = [] } = node;

const colClass = 
	columns === "2" ? "grid-cols-1 md:grid-cols-2" :
	columns === "4" ? "grid-cols-1 md:grid-cols-2 lg:grid-cols-4" :
	"grid-cols-1 md:grid-cols-2 lg:grid-cols-3";
---

<section class="section py-16 md:py-24">
	<div class="container mx-auto px-4 max-w-7xl">
		{(eyebrow || title || subtitle) && (
			<div class="section-head text-center max-w-3xl mx-auto mb-12">
				{eyebrow && (
					<span class="eyebrow inline-block text-xs font-semibold tracking-wider uppercase text-altix-red dark:text-altix-red-light mb-2">
						{eyebrow}
					</span>
				)}
				{title && (
					<h2 class="text-3xl md:text-4xl font-bold tracking-tight text-navy dark:text-white mb-4">
						{title}
					</h2>
				)}
				{subtitle && (
					<p class="text-base md:text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
						{subtitle}
					</p>
				)}
			</div>
		)}

		{cards && cards.length > 0 ? (
			<div class={`grid gap-8 ${colClass}`}>
				{cards.map((card) => (
					<article class="group relative flex flex-col rounded-2xl overflow-hidden bg-white dark:bg-gray-850 border border-gray-200/80 dark:border-gray-700/80 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
						{card.imageUrl && (
							<div class="aspect-[16/10] overflow-hidden bg-gray-100 dark:bg-gray-800">
								<img 
									src={card.imageUrl} 
									alt={card.title} 
									class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
									loading="lazy"
								/>
							</div>
						)}

						<div class="flex-1 p-6 md:p-8 flex flex-col justify-between">
							<div>
								{card.badge && (
									<span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-altix-red/10 dark:bg-navy-dark/70 text-altix-red-hover dark:text-altix-red-light mb-4 border border-altix-red/20 dark:border-navy2/50">
										{card.badge}
									</span>
								)}
								<h3 class="text-xl font-bold text-navy dark:text-white mb-3 group-hover:text-altix-red dark:group-hover:text-altix-red-light transition-colors">
									{card.title}
								</h3>
								{card.description && (
									<p class="text-sm md:text-base text-gray-600 dark:text-gray-300 leading-relaxed mb-6">
										{card.description}
									</p>
								)}
							</div>

							{card.linkText && card.linkUrl && (
								<div class="pt-4 border-t border-gray-100 dark:border-gray-800">
									<a 
										href={card.linkUrl} 
										class="inline-flex items-center text-sm font-semibold text-altix-red dark:text-altix-red-light hover:text-altix-red-hover dark:hover:text-altix-red-light transition-colors gap-1.5"
									>
										<span>{card.linkText}</span>
										<svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<path d="m9 18 6-6-6-6"/>
										</svg>
									</a>
								</div>
							)}
						</div>
					</article>
				))}
			</div>
		) : (
			<div class="text-center py-12 border-2 border-dashed border-gray-300 dark:border-gray-700 rounded-2xl">
				<p class="text-gray-500 dark:text-gray-400">No cards added to this section yet.</p>
			</div>
		)}
	</div>
</section>
