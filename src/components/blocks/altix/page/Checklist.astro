---
import SectionHead from "./SectionHead.astro";
import { splitLines } from "../../../../lib/blocks";

interface Props {
	node: { eyebrow?: string; title?: string; subtitle?: string; items?: string | string[] };
}
const { node } = Astro.props;
const items = splitLines(node.items);
---

<section class="section">
	<div class="container">
		<SectionHead eyebrow={node.eyebrow} title={node.title} subtitle={node.subtitle} />
		<ul class="check-grid">
			{items.map((item) => <li>{item}</li>)}
		</ul>
	</div>
</section>
