---
interface Props {
	node: {
		eyebrow?: string;
		headline?: string;
		subheadline?: string;
		beforeImage: string;
		beforeLabel?: string;
		afterImage: string;
		afterLabel?: string;
	};
}

const { node } = Astro.props;
const {
	eyebrow,
	headline,
	subheadline,
	beforeImage,
	beforeLabel = "Before",
	afterImage,
	afterLabel = "After",
} = node;

const sliderId = "before-after-" + Math.random().toString(36).substring(2, 9);
---

<section class="section py-16 md:py-24">
	<div class="container mx-auto px-4 max-w-5xl">
		{(eyebrow || headline || subheadline) && (
			<div class="section-head text-center max-w-3xl mx-auto mb-12">
				{eyebrow && <span class="eyebrow inline-block text-xs font-semibold tracking-wider uppercase text-altix-red dark:text-altix-red-light mb-2">{eyebrow}</span>}
				{headline && <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-navy dark:text-white mb-4">{headline}</h2>}
				{subheadline && <p class="text-base md:text-lg text-gray-600 dark:text-gray-300 leading-relaxed">{subheadline}</p>}
			</div>
		)}

		{beforeImage && afterImage ? (
			<div 
				class="before-after-container relative w-full aspect-[16/10] md:aspect-[16/9] rounded-2xl overflow-hidden select-none shadow-xl border border-gray-200 dark:border-gray-700 bg-gray-100 dark:bg-gray-800"
				id={sliderId}
			>
				<!-- Before Image (Base Layer) -->
				<img 
					src={beforeImage} 
					alt={beforeLabel} 
					class="absolute inset-0 w-full h-full object-cover pointer-events-none"
				/>
				<span class="absolute top-4 left-4 z-10 px-3 py-1 rounded-full text-xs font-semibold bg-black/60 text-white backdrop-blur-sm pointer-events-none shadow-sm">
					{beforeLabel}
				</span>

				<!-- After Image (Clipped Overlay Layer) -->
				<div class="after-overlay absolute inset-0 overflow-hidden pointer-events-none" style="width: 50%;">
					<img 
						src={afterImage} 
						alt={afterLabel} 
						class="absolute inset-0 w-full h-full object-cover max-w-none"
						style="width: 100vw; max-width: calc(100% * 2);"
					/>
					<span class="absolute top-4 right-4 z-10 px-3 py-1 rounded-full text-xs font-semibold bg-altix-red/90 text-white backdrop-blur-sm pointer-events-none shadow-sm">
						{afterLabel}
					</span>
				</div>

				<!-- Draggable Divider Line & Handle -->
				<div class="divider-handle absolute top-0 bottom-0 z-20 w-1 bg-white shadow-[0_0_10px_rgba(0,0,0,0.4)] pointer-events-none" style="left: 50%;">
					<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white dark:bg-gray-900 border-2 border-altix-red shadow-lg flex items-center justify-center text-altix-red dark:text-altix-red-light cursor-ew-resize pointer-events-auto">
						<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="m9 18-6-6 6-6"/>
							<path d="m15 6 6 6-6 6"/>
						</svg>
					</div>
				</div>

				<!-- Hidden Range Input for full touch and mouse drag accessibility -->
				<input 
					type="range" 
					min="0" 
					max="100" 
					value="50" 
					class="slider-range absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-30 m-0"
					aria-label="Drag to compare before and after images"
				/>
			</div>
		) : (
			<div class="text-center py-12 border-2 border-dashed border-gray-300 dark:border-gray-700 rounded-2xl">
				<p class="text-gray-500 dark:text-gray-400">Please provide both Before and After image URLs.</p>
			</div>
		)}
	</div>
</section>

<script define:vars={{ sliderId }}>
	const container = document.getElementById(sliderId);
	if (container) {
		const rangeInput = container.querySelector(".slider-range");
		const overlay = container.querySelector(".after-overlay");
		const divider = container.querySelector(".divider-handle");
		const afterImg = overlay ? overlay.querySelector("img") : null;

		const updatePosition = (val) => {
			if (overlay) overlay.style.width = `${val}%`;
			if (divider) divider.style.left = `${val}%`;
			if (afterImg) {
				const containerWidth = container.offsetWidth;
				afterImg.style.width = `${containerWidth}px`;
			}
		};

		if (rangeInput) {
			rangeInput.addEventListener("input", (e) => {
				updatePosition(e.target.value);
			});
		}

		window.addEventListener("resize", () => {
			if (rangeInput) updatePosition(rangeInput.value);
		});

		// Initial sync
		if (rangeInput) updatePosition(rangeInput.value);
	}
</script>
