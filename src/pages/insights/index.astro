---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	status: "published",
	orderBy: { published_at: "desc" },
});

if (Astro.cache?.enabled && cacheHint) {
	Astro.cache.set(cacheHint);
}

const publishedPosts = (posts || []).filter((post) => {
	const status = post.data?.status || (post as any).status;
	return status === "published";
});

const sortedPosts = publishedPosts.toSorted((a, b) => {
	const dateA = new Date(a.data.publishedAt || a.data.createdAt || 0).getTime();
	const dateB = new Date(b.data.publishedAt || b.data.createdAt || 0).getTime();
	return dateB - dateA;
});
---

<Base
	title="Insights | ALTIX Exchange"
	description="Market Analysis & Professional Commentary"
>
	<div class="insights-page">
		<section class="hero-section section bg-[#f8fafc]">
			<div class="container">
				<div class="eyebrow mb-3">
					<span>Market Analysis & Professional Commentary</span>
				</div>
				<h1 class="page-title">Insights</h1>
				<p class="lead-text">
					Market Analysis & Professional Commentary
				</p>
			</div>
		</section>

		<section class="content-section section">
			<div class="container">
				{
					sortedPosts.length === 0 ? (
						<div class="empty-state">
							<h3>No insights published yet</h3>
							<p>Check back soon for market analysis and professional commentary from ALTIX Exchange.</p>
						</div>
					) : (
						<div class="posts-grid">
							{sortedPosts.map((post) => {
								const slug = post.data.slug || post.id;
								const postDate = post.data.publishedAt || post.data.createdAt;
								const formattedDate = postDate
									? new Date(postDate).toLocaleDateString("en-US", {
											year: "numeric",
											month: "long",
											day: "numeric",
										})
									: null;

								return (
									<article class="post-card">
										{post.data.featured_image && (
											<div class="post-image-wrapper" {...post.edit?.featured_image}>
												<Image image={post.data.featured_image} />
											</div>
										)}
										<div class="post-card-content">
											{formattedDate && (
												<time datetime={new Date(postDate).toISOString()} class="post-date">
													{formattedDate}
												</time>
											)}
											<h2 class="post-title" {...post.edit?.title}>
												<a href={`/insights/${slug}`}>{post.data.title}</a>
											</h2>
											{post.data.excerpt && (
												<p class="post-excerpt" {...post.edit?.excerpt}>
													{post.data.excerpt}
												</p>
											)}
											<a href={`/insights/${slug}`} class="text-link read-more">
												Read article &rarr;
											</a>
										</div>
									</article>
								);
							})}
						</div>
					)
				}
			</div>
		</section>
	</div>
</Base>

<style>
	.hero-section {
		padding-top: 4rem;
		padding-bottom: 4rem;
		border-bottom: 1px solid var(--line);
	}

	.page-title {
		font-family: var(--font-serif);
		font-size: clamp(2.25rem, 4vw, 3.25rem);
		font-weight: 700;
		color: var(--navy);
		line-height: 1.2;
		margin-bottom: 1rem;
	}

	.lead-text {
		font-size: 1.25rem;
		line-height: 1.6;
		color: var(--muted);
		margin-bottom: 0;
		max-width: 75ch;
	}

	.content-section {
		padding-top: 4rem;
		padding-bottom: 5rem;
	}

	.empty-state {
		text-align: center;
		padding: 4rem 2rem;
		background: #ffffff;
		border: 1px solid var(--line);
		border-radius: 12px;
		max-width: 600px;
		margin: 0 auto;
	}

	.empty-state h3 {
		font-size: 1.5rem;
		color: var(--navy);
		margin-bottom: 0.5rem;
	}

	.empty-state p {
		color: var(--muted);
		margin: 0;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: 2rem;
	}

	.post-card {
		background: #ffffff;
		border: 1px solid var(--line);
		border-radius: 12px;
		overflow: hidden;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
		transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
		display: flex;
		flex-direction: column;
	}

	.post-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
		border-color: rgba(230, 70, 58, 0.3);
	}

	.post-image-wrapper {
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--soft);
	}

	.post-image-wrapper :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.post-card:hover .post-image-wrapper :global(img) {
		transform: scale(1.03);
	}

	.post-card-content {
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.post-date {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--muted);
		margin-bottom: 0.5rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.post-title {
		font-family: var(--font-serif);
		font-size: 1.35rem;
		font-weight: 700;
		color: var(--navy);
		line-height: 1.3;
		margin-bottom: 0.75rem;
	}

	.post-title a {
		text-decoration: none;
		color: inherit;
		transition: color 0.2s ease;
	}

	.post-title a:hover {
		color: var(--red);
	}

	.post-excerpt {
		color: var(--muted);
		font-size: 0.975rem;
		line-height: 1.6;
		margin-bottom: 1.5rem;
		flex-grow: 1;
	}

	.read-more {
		margin-top: auto;
	}

	@media (max-width: 768px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}

		.page-title {
			font-size: 2rem;
		}

		.lead-text {
			font-size: 1.1rem;
		}
	}
</style>
