---
import { getSiteSettings } from "emdash";
import { EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import UtilityBar from "../components/UtilityBar.astro";
import SiteChrome from "../components/react/SiteChrome";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title, description, image } = Astro.props;

const defaultTitle = "ALTIX Exchange | Litigation Finance & Global Asset Recovery";
const defaultDescription = "ALTIX prepares selected legal and recovery matters for professional funding through structured assessment, evidence organization, collectability analysis and controlled investor access.";

let settings;
try {
	settings = await getSiteSettings();
} catch (e) {
	settings = null;
}

const siteTitle = settings?.title || defaultTitle;
const fullTitle = title ? (title.includes("ALTIX") ? title : `${title} | ALTIX Exchange`) : siteTitle;
const fullDescription = description || settings?.tagline || defaultDescription;

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: fullDescription,
	canonical: Astro.url.href,
	image,
	seo: { ogImage: image },
	siteName: "ALTIX Exchange",
});

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"@id": "https://altix.exchange/#organization",
	name: "ALTIX Exchange",
	alternateName: ["ALTIX", "Alternative Investment Exchange"],
	url: "https://altix.exchange/",
	description:
		"ALTIX Exchange is a Singapore-based technology and services company serving litigation finance and global asset recovery.",
	email: "info@altix.exchange",
	founder: {
		"@id": "https://altix.exchange/about/leadership/elke-biechele/#person",
	},
	sameAs: [
		"https://x.com/AltixExchange",
		"https://www.linkedin.com/in/elke-biechele/",
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#17192b" />
		<title>{fullTitle}</title>
		<meta name="description" content={fullDescription} />
		<link rel="icon" type="image/png" href="/assets/img/favicon.png" />
		<link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg" />
		<link rel="apple-touch-icon" href="/assets/img/favicon.png" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={fullDescription} />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:site_name" content="ALTIX Exchange" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<a class="skip-link" href="#main">
			Skip to content
		</a>
		<UtilityBar />
		<SiteChrome client:load />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
